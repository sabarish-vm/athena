<comment>
problem   = Newtonian Bondi accretion
reference = Gardiner. T.A. & Stone, J.M., JCP, 205, 509 (2005) (for MHD version of test)
configure = --prob=bondi --coord=spherical_polar

<job>
problem_id = Bondi      # problem ID: basename of output filenames

<output1>
file_type  = hdf5       # Binary data dump
variable   = prim       # variables to be output
dt         = 0.01       # time increment between outputs

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 0.005       # time limit
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1000         # interval for stdout summary info

<mesh>
nx1         = 512                # Number of zones in X1-direction
x1min       = 5e-5               # minimum value of X1
x1max       = 5e-1               # maximum value of X1
x1rat       = 1.018151721718182  # (xmax/xmin)^(1/nx1)
ix1_bc      = outflow            # inner-X1 boundary flag
ox1_bc      = @BC_VAL@           # outer-X1 boundary flag

nx2        = 1                  # Number of zones in X2-direction
x2min      = 0.0                # minimum value of X2
x2max      = 3.141592653589793  # maximum value of X2
x2rat      = 1.0
ix2_bc     = outflow            # inner-X2 boundary flag
ox2_bc     = outflow            # outer-X2 boundary flag

nx3        = 1              # Number of zones in X3-direction
x3min      = -0.78539816339 # minimum value of X3
x3max      =  0.78539816339 # maximum value of X3
ix3_bc     = outflow        # inner-X3 boundary flag
ox3_bc     = outflow        # outer-X3 boundary flag


<hydro>
gamma           = 1.1  # gamma = C_p/C_v

<problem>
rho_infty = 1.0
cs_infty = 1.0
ur_infty = -1e-4
mbh = 1.0
ic_mode = @IC@
bc_mode = @BC@
sbm_cgs = @SBM_CGS@

<units> # Units such that rho_infty is 1, cs_infty is 1, mbh is 1
unit_system = custom
mass_cgs = 1.98840987069805e+34    #
length_cgs = 2.70916404670302e+17  #
time_cgs = 2.70916404670302e+11    #

#<units> # Units such that rho_infty is 1, cs_infty is 1, rB is 1
#unit_system = custom
#length_cgs = 1.32712440000000e+15  # Bondi units in cm
#mass_cgs = 2.33741002331213e+27    # Bondi units in g
#time_cgs = 1.32712440000000e+09    # Bondi units in s
